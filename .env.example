# Copy this file to .env and fill in real values for local dev.

# Postgres
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=pulsecheck
POSTGRES_DB=pulsecheck
DATABASE_URL=postgresql+psycopg2://pulsecheck:pulsecheck@db:5432/pulsecheck

# Redis (rate limiting only — no longer a task queue broker)
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# When true, every request except /healthz gets a static "under maintenance"
# page and the app never touches Postgres at startup. For running the live
# demo URL cheaply while the DB is deliberately stopped, not for local dev.
MAINTENANCE_MODE=false

# SMTP (use a free Mailtrap/Mailhog inbox for local dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@cronbell.local
SMTP_USE_TLS=true

# Shared secret an external scheduler must send (as X-Internal-Token) to
# call POST /internal/run-overdue-check and /internal/run-inactivity-check.
INTERNAL_CRON_TOKEN=change-me-to-a-long-random-string

# Kept for reference — no longer a Celery beat interval, just documents the
# cadence the external cron (see .github/workflows/) is expected to run at.
OVERDUE_CHECK_INTERVAL_SECONDS=60

# Comma-separated emails that get access to /admin
ADMIN_EMAILS=you@example.com

# Inactivity cleanup: reminder, second reminder, then deletion (days of no
# login and no monitor pings). Checked once a day.
INACTIVITY_REMINDER_DAYS=60
INACTIVITY_SECOND_REMINDER_DAYS=75
INACTIVITY_DELETE_DAYS=90
INACTIVITY_CHECK_INTERVAL_SECONDS=86400
